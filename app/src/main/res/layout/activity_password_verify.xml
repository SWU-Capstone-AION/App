<?xml version="1.0" encoding="utf-8"?>
<!--
    화면 1: 비밀번호 변경 전 확인
    - 상단 헤더 (뒤로가기 + 제목)
    - 안내 문구
    - 아이디 입력
    - 현재 비밀번호 입력
    - 에러 메시지
    - 다음 버튼

    헤더는 팀 공통 include_header_*.xml이 확정되면 그쪽으로 교체할 것.
    지금은 화면 안에 직접 그려둠 (TODO: 공통화).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/password_screen_bg"
    tools:context=".function.password.eunseo.PasswordVerifyActivity">

    <!-- ===== Header ===== -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="@dimen/password_header_height"
        android:layout_height="@dimen/password_header_height"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_back"
        android:padding="@dimen/password_spacing_m"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="0dp"
        android:layout_height="@dimen/password_header_height"
        android:gravity="center"
        android:text="@string/password_verify_title"
        android:textColor="@color/password_text_primary"
        android:textSize="@dimen/password_text_input"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/password_divider"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <!-- ===== Body ===== -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/password_spacing_xl"
        android:text="@string/password_verify_title"
        android:textColor="@color/password_text_primary"
        android:textSize="@dimen/password_text_title"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        android:paddingStart="@dimen/password_screen_padding_horizontal"
        android:paddingEnd="@dimen/password_screen_padding_horizontal" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/password_spacing_s"
        android:text="@string/password_verify_description"
        android:textColor="@color/password_text_secondary"
        android:textSize="@dimen/password_text_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        android:paddingStart="@dimen/password_screen_padding_horizontal"
        android:paddingEnd="@dimen/password_screen_padding_horizontal" />

    <EditText
        android:id="@+id/etUserId"
        android:layout_width="0dp"
        android:layout_height="@dimen/password_input_height"
        android:layout_marginTop="@dimen/password_spacing_xl"
        android:layout_marginStart="@dimen/password_screen_padding_horizontal"
        android:layout_marginEnd="@dimen/password_screen_padding_horizontal"
        android:autofillHints="username"
        android:background="@drawable/bg_password_edit_text"
        android:hint="@string/password_verify_hint_id"
        android:importantForAutofill="yes"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/password_text_primary"
        android:textColorHint="@color/password_text_hint"
        android:textSize="@dimen/password_text_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDescription" />

    <EditText
        android:id="@+id/etCurrentPassword"
        android:layout_width="0dp"
        android:layout_height="@dimen/password_input_height"
        android:layout_marginTop="@dimen/password_spacing_m"
        android:layout_marginStart="@dimen/password_screen_padding_horizontal"
        android:layout_marginEnd="@dimen/password_screen_padding_horizontal"
        android:autofillHints="password"
        android:background="@drawable/bg_password_edit_text"
        android:hint="@string/password_verify_hint_current_pw"
        android:importantForAutofill="yes"
        android:inputType="textPassword"
        android:maxLines="1"
        android:textColor="@color/password_text_primary"
        android:textColorHint="@color/password_text_hint"
        android:textSize="@dimen/password_text_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etUserId" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/password_spacing_s"
        android:layout_marginStart="@dimen/password_screen_padding_horizontal"
        android:layout_marginEnd="@dimen/password_screen_padding_horizontal"
        android:textColor="@color/password_text_error"
        android:textSize="@dimen/password_text_error"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etCurrentPassword"
        tools:text="비밀번호가 일치하지 않습니다."
        tools:visibility="visible" />

    <!-- ===== Bottom button ===== -->
    <Button
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="@dimen/password_button_height"
        android:layout_marginBottom="@dimen/password_spacing_l"
        android:layout_marginStart="@dimen/password_screen_padding_horizontal"
        android:layout_marginEnd="@dimen/password_screen_padding_horizontal"
        android:background="@drawable/bg_password_button"
        android:enabled="false"
        android:stateListAnimator="@null"
        android:text="@string/password_verify_btn_next"
        android:textColor="@color/password_button_text"
        android:textSize="@dimen/password_text_button"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
