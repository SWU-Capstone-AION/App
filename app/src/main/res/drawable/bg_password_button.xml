<?xml version="1.0" encoding="utf-8"?>
<!--
    비밀번호 화면용 버튼 배경.
    enabled=true → 보라색, enabled=false → 회색.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/password_button_enabled" />
            <corners android:radius="@dimen/password_corner_radius" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/password_button_disabled" />
            <corners android:radius="@dimen/password_corner_radius" />
        </shape>
    </item>
</selector>
