<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 인터넷 권한 (Firebase 통신에 필요) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 카메라 권한 (모니터링 기능) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 전면/외장 카메라도 허용해야 하므로 camera.any 사용 -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- 알림 권한 (Android 13 이상) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AIONapp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AIONapp"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 카메라 사진 전달용 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- FCM 토큰 갱신 처리 -->
        <service
            android:name=".data.messaging.AionMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 알림 채널 지정 (앱이 백그라운드일 때 시스템이 자동 표시할 알림에 사용) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="aion_alert" />

    </application>

</manifest>