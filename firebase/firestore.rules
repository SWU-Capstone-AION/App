rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 공통 함수 =====

    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 바뀌는 필드가 지정한 목록 안에만 있는지 검사
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(fields);
    }

    // 필드가 없거나 null 이면 true.
    // 규칙에서는 없는 필드를 직접 읽으면 에러가 나므로 get() 으로 기본값을 준다.
    function isEmpty(data, field) {
      return data.get(field, null) == null;
    }

    // ===== loginIds =====
    // 아이디 → uid·이메일 역인덱스.
    // 로그인·아이디 중복확인·비밀번호 찾기가 로그인 전에 읽어야 하므로 get은 열어둔다.
    //
    // list(목록 조회)는 막는다. 열어두면 전체 아이디와 이메일을 통째로 긁어갈 수 있다.
    // 앱은 항상 문서를 직접 지목해서 읽으므로 get만 있으면 충분하다.
    match /loginIds/{loginId} {
      allow get: if true;
      allow list: if false;

      // 회원가입 때 한 번만 만든다. 수정·삭제는 앱에서 하지 않는다.
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ===== users =====
    match /users/{uid} {

      // --- 읽기 ---
      // 문서 하나 직접 조회: 본인, 또는 로그인한 사용자가 다른 계정을 볼 때.
      // (교사가 아동을 검색하거나, 아동이 초대한 교사 정보를 볼 때 필요)
      allow get: if isMe(uid) || isSignedIn();

      // 목록 조회: 로그인한 사용자만.
      // 아이디 찾기(이메일로 조회)는 로그인 전에 쓰이지만, 열어두면
      // 전체 회원 정보를 긁어갈 수 있어 막는다.
      allow list: if isSignedIn();

      // --- 생성 ---
      // 회원가입. 자기 문서만, 역할은 둘 중 하나만 쓸 수 있다.
      allow create: if isMe(uid)
                    && request.resource.data.role in ['TEACHER', 'CHILD'];

      // --- 수정 ---
      allow update: if
        // (1) 본인이 자기 프로필·FCM 토큰을 고치는 경우.
        //     역할과 아이디는 못 바꾸게 막는다.
        (isMe(uid)
          && onlyChanges([
               'name', 'gender', 'birthYear', 'birthMonth', 'birthDay',
               'sensoryTraits', 'behaviors', 'fcmToken'
             ]))

        // (2) 교사가 아동에게 연결을 요청하는 경우.
        //     자기 자신을 요청자로만 쓸 수 있고,
        //     아직 담당 교사도 대기 중인 요청도 없어야 한다.
        || (isSignedIn()
          && onlyChanges(['pendingTeacherId'])
          && request.resource.data.pendingTeacherId == request.auth.uid
          && isEmpty(resource.data, 'teacherId')
          && isEmpty(resource.data, 'pendingTeacherId'))

        // (3) 아동이 초대를 수락하거나 거절하는 경우.
        //     수락하면 요청자가 그대로 담당 교사가 되고,
        //     거절하면 요청만 지워진다.
        || (isMe(uid)
          && onlyChanges(['teacherId', 'pendingTeacherId'])
          && isEmpty(request.resource.data, 'pendingTeacherId')
          && (request.resource.data.get('teacherId', null)
                == resource.data.get('pendingTeacherId', null)
              || isEmpty(request.resource.data, 'teacherId')));

      // --- 삭제 ---
      // 앱에 탈퇴 기능이 없다. 필요하면 콘솔에서 지운다.
      allow delete: if false;
    }
  }
}